{
  "configs": {},
  "networks": {
    "database-order-history": {
      "internal": true,
      "labels": {
        "dev.starter.owner": "fixture-owner",
      },
    },
    "private": {
      "internal": true,
      "labels": {
        "dev.starter.owner": "fixture-owner",
      },
    },
  },
  "secrets": {
    "broker-password": {
      "file": "/fixture/$$installation/secrets/broker-password",
    },
    "order-history-admin-password": {
      "file": "/fixture/$$installation/secrets/order-history-admin-password",
    },
    "order-history-owner-password": {
      "file": "/fixture/$$installation/secrets/order-history-owner-password",
    },
    "order-history-runtime-password": {
      "file": "/fixture/$$installation/secrets/order-history-runtime-password",
    },
  },
  "services": {
    "app-order-history": {
      "environment": {
        "NODE_ENV": "production",
        "ORDER_HISTORY_DB_HOST": "postgres-order-history",
        "ORDER_HISTORY_DB_NAME": "order_history",
        "ORDER_HISTORY_DB_PASSWORD_FILE": "/run/secrets/order-history-runtime-password",
        "ORDER_HISTORY_DB_PORT": "5432",
        "ORDER_HISTORY_DB_USERNAME": "order_history_runtime",
        "ORDER_HISTORY_HTTP_PORT": "3000",
        "RABBITMQ_HOST": "rabbitmq",
        "RABBITMQ_PASSWORD_FILE": "/run/secrets/broker-password",
        "RABBITMQ_PORT": "5672",
        "RABBITMQ_USERNAME": "scaffold",
        "RABBITMQ_VHOST": "fixture-installation",
      },
      "healthcheck": {
        "interval": "2s",
        "retries": 30,
        "test": [
          "CMD",
          "bun",
          "-e",
          "process.exit((await fetch('http://127.0.0.1:3000/health/live')).ok ? 0 : 1)",
        ],
        "timeout": "5s",
      },
      "image": "example/order-history@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "labels": {
        "dev.starter.owner": "fixture-owner",
      },
      "networks": [
        "private",
        "database-order-history",
      ],
      "profiles": [
        "applications",
      ],
      "secrets": [
        "order-history-runtime-password",
        "broker-password",
      ],
      "stop_grace_period": "20s",
    },
    "migrate-order-history": {
      "command": [
        "run",
        "migration:status",
      ],
      "environment": {
        "DATABASE_APP": "order-history",
        "NODE_ENV": "production",
        "ORDER_HISTORY_DB_HOST": "postgres-order-history",
        "ORDER_HISTORY_DB_MIGRATION_PASSWORD_FILE": "/run/secrets/order-history-owner-password",
        "ORDER_HISTORY_DB_MIGRATION_USERNAME": "order_history_owner",
        "ORDER_HISTORY_DB_NAME": "order_history",
        "ORDER_HISTORY_DB_PORT": "5432",
      },
      "image": "example/order-history@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "labels": {
        "dev.starter.owner": "fixture-owner",
      },
      "networks": [
        "database-order-history",
      ],
      "profiles": [
        "commands",
      ],
      "secrets": [
        "order-history-owner-password",
      ],
    },
    "postgres-order-history": {
      "environment": {
        "POSTGRES_DB": "order_history",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/order-history-admin-password",
      },
      "healthcheck": {
        "interval": "2s",
        "retries": 30,
        "test": [
          "CMD-SHELL",
          "pg_isready -h 127.0.0.1 -U postgres -d "$$POSTGRES_DB"",
        ],
        "timeout": "5s",
      },
      "image": "postgres:18.6-alpine",
      "labels": {
        "dev.starter.owner": "fixture-owner",
      },
      "networks": [
        "database-order-history",
      ],
      "secrets": [
        "order-history-admin-password",
        "order-history-owner-password",
        "order-history-runtime-password",
      ],
      "volumes": [
        "postgres-order-history:/var/lib/postgresql",
      ],
    },
    "rabbitmq": {
      "entrypoint": [
        "/bin/sh",
        "-ec",
        "export RABBITMQ_DEFAULT_PASS="$$(cat /run/secrets/broker-password)"; exec docker-entrypoint.sh rabbitmq-server",
      ],
      "environment": {
        "RABBITMQ_DEFAULT_USER": "scaffold",
        "RABBITMQ_DEFAULT_VHOST": "fixture-installation",
      },
      "healthcheck": {
        "interval": "2s",
        "retries": 30,
        "test": [
          "CMD",
          "docker-entrypoint.sh",
          "rabbitmq-diagnostics",
          "-q",
          "check_port_connectivity",
        ],
        "timeout": "5s",
      },
      "hostname": "fixture-installation-rabbitmq",
      "image": "rabbitmq:4-management-alpine@sha256:628bd74c1c7e2a820bf417b32e75eed1bd8d517345d9749ee8bd4076ae393abe",
      "labels": {
        "dev.starter.owner": "fixture-owner",
      },
      "networks": [
        "private",
      ],
      "secrets": [
        "broker-password",
      ],
      "volumes": [
        "rabbitmq:/var/lib/rabbitmq",
      ],
    },
  },
  "volumes": {
    "postgres-order-history": {
      "labels": {
        "dev.starter.owner": "fixture-owner",
      },
    },
    "rabbitmq": {
      "labels": {
        "dev.starter.owner": "fixture-owner",
      },
    },
  },
}
`;

