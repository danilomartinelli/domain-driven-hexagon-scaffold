{
  "name": "infrastructure",
  "projectType": "library",
  "tags": ["scope:tooling"],
  "targets": {
    "prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file scripts/environment-cli.ts --nx prepare",
        "cwd": "."
      }
    },
    "exec": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file scripts/environment-cli.ts --nx exec",
        "cwd": "."
      }
    },
    "down": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file scripts/environment-cli.ts --nx down",
        "cwd": "."
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file scripts/environment-cli.ts --nx dev",
        "cwd": "."
      }
    },
    "up": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file scripts/environment-cli.ts --nx prepare --environment=development",
        "cwd": "."
      }
    },
    "up-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file scripts/environment-cli.ts --nx prepare --environment=test",
        "cwd": "."
      }
