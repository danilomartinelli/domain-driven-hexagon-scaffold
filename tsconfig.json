{
  "compilerOptions": {
    "paths": {
      "@src/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"],
      "@config/*": ["./src/configs/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "database/**/*.mjs",
    "tooling/**/*.mjs",
    "eslint.config.mjs",
    "prettier.config.mjs",
    ".dependency-cruiser.mjs"
  ],
  "extends": "./tooling/config/typescript.json"
}
