{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "oauth": false
    },
    "nx": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "cd \"$(git rev-parse --show-toplevel)\" && exec bun run nx mcp --minimal"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },
  "formatter": {
    "prettier": {
      "command": [
        "sh",
        "-c",
        "exec bun --no-env-file \"$(git rev-parse --show-toplevel)/scripts/format-agent-edit.ts\" --file \"$1\"",
        "agent-format",
        "$FILE"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".json",
        ".jsonc",
        ".md",
        ".yaml",
        ".yml"
      ]
    }
  },
  "lsp": {
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mts",
        ".cts",
        ".mjs",
        ".cjs"
      ]
    }
  },
  "agent": {
    "standards-reviewer": {
      "description": "Review an immutable Git comparison against repository standards and architectural boundaries.",
      "mode": "subagent",
      "prompt": "{file:./.agents/reviewers/standards.md}",
      "permission": { "edit": "deny", "task": "deny" }
    },
    "spec-reviewer": {
      "description": "Review an immutable Git comparison against the supplied user request, issue or specification.",
      "mode": "subagent",
      "prompt": "{file:./.agents/reviewers/spec.md}",
      "permission": { "edit": "deny", "task": "deny" }
    }
  }
}
