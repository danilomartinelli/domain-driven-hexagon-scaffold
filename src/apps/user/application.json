{
  "name": "user",
  "persistence": true,
  "messaging": true,
  "exposure": true,
  "routes": [
    { "name": "rest", "paths": ["~/v1/users(?:/|$)"], "stripPath": false },
    {
      "name": "graphql",
      "paths": ["~/user/graphql/?$"],
      "stripPath": true,
      "upstreamPath": "/graphql"
    }
  ]
}
