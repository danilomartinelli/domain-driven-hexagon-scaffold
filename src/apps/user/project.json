{
  "name": "user",
  "projectType": "application",
  "tags": ["scope:user", "type:app"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "bun --bun eslint src/apps/user --max-warnings 0",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "bun --bun tsc --project src/apps/user/tsconfig.json",
        "cwd": "."
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/src/type-tests/**/*.ts"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "bun test ./src/apps/user/tests/unit",
        "cwd": "."
      }
    },
    "test-watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun test --watch ./src/apps/user/tests/unit",
        "cwd": "."
      }
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun test --coverage ./src/apps/user/tests/unit",
        "cwd": "."
      }
    },
    "test-debug": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --inspect-brk test ./src/apps/user/tests/unit",
        "cwd": "."
      }
    },
    "test-component": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun scripts/with-test-database.ts --app=user -- bun run nx run user:test-component-prepared",
        "cwd": "."
      }
    },
    "test-component-prepared": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun test --preload ./src/apps/user/tests/component/preload.ts ./src/apps/user/tests/component",
        "cwd": "."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file scripts/serve-application.ts user serve",
        "cwd": "."
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file scripts/serve-application.ts user watch",
        "cwd": "."
      }
    },
    "debug": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file scripts/serve-application.ts user debug",
        "cwd": "."
      }
    },
    "lint-fix": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --bun eslint src/apps/user --max-warnings 0 --fix",
        "cwd": "."
      }
    },
    "failures-inspect": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file scripts/failure-queue.ts user inspect",
        "cwd": "."
      }
    },
    "failures-replay": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file scripts/failure-queue.ts user replay",
        "cwd": "."
      }
    },
    "distribution": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/user"],
      "options": {
        "command": "bun --no-env-file scripts/distribute.ts user",
        "cwd": "."
      }
    },
    "serve-distribution": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file run start",
        "cwd": "dist/user"
      }
    },
    "migration-up-distribution": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file run migration:up",
        "cwd": "dist/user"
      }
    },
    "migration-down-distribution": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file run migration:down",
        "cwd": "dist/user"
      }
    },
    "migration-status-distribution": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file run migration:status",
        "cwd": "dist/user"
      }
    },
    "test-distribution": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun scripts/with-test-database.ts --app=user --no-database-setup -- bun test ./scripts/tests/distribution-user.test.ts && if [ -n \"$DDH_VALIDATED_IMAGE\" ] || [ -n \"$DDH_IMAGE_PLATFORM\" ]; then bun scripts/with-test-database.ts --app=user --no-database-setup -- bun test ./scripts/tests/distribution-shutdown.test.ts; fi",
        "cwd": "."
      }
    }
  },
  "implicitDependencies": ["test-runner"]
}
