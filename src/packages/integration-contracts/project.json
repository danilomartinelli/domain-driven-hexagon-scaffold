{
  "name": "integration-contracts",
  "projectType": "library",
  "tags": ["scope:shared", "type:contracts"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "bun --bun eslint src/packages/integration-contracts --max-warnings 0",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "bun --bun tsc --project src/packages/integration-contracts/tsconfig.json",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "bun test ./src/packages/integration-contracts/tests",
        "cwd": "."
      }
    },
    "test-watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun test --watch ./src/packages/integration-contracts/tests",
        "cwd": "."
      }
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun test --coverage ./src/packages/integration-contracts/tests",
        "cwd": "."
      }
    },
    "test-debug": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --inspect-brk test ./src/packages/integration-contracts/tests",
        "cwd": "."
      }
    },
    "lint-fix": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --bun eslint src/packages/integration-contracts --max-warnings 0 --fix",
        "cwd": "."
      }
    }
  }
}
