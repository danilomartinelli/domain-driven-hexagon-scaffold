# Optional custom User database tooling target. Export these variables explicitly;
# applications do not load this file. The recommended env:exec workflow generates
# owned User/Wallet targets and preserves shell overrides. See docs/database.md.
USER_DB_HOST='localhost'
USER_DB_PORT=5433
USER_DB_MIGRATION_USERNAME='user_owner'
USER_DB_MIGRATION_PASSWORD='replace-with-your-local-owner-password'
USER_DB_NAME='user'
