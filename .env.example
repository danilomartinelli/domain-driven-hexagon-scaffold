# Optional custom database tooling targets. Export these variables explicitly;
# applications do not load this file. The recommended `make dev` and env:exec
# workflows generate owned User/Wallet targets with allocated ports and preserve
# shell overrides. See docs/database.md.
# Select Wallet for migration/seed commands with DATABASE_APP=wallet (default: user).
USER_DB_HOST='localhost'
USER_DB_PORT=5432
USER_DB_MIGRATION_USERNAME='user_owner'
USER_DB_MIGRATION_PASSWORD='replace-with-your-local-owner-password'
USER_DB_NAME='user'
WALLET_DB_HOST='localhost'
WALLET_DB_PORT=5432
WALLET_DB_MIGRATION_USERNAME='wallet_owner'
WALLET_DB_MIGRATION_PASSWORD='replace-with-your-local-owner-password'
WALLET_DB_NAME='wallet'
