{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check full workspace",
      "type": "shell",
      "command": "bun run check:full",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Typecheck workspace",
      "type": "shell",
      "command": "bun run typecheck",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$tsc",
      "group": "test"
    },
    {
      "label": "Test without infrastructure",
      "type": "shell",
      "command": "bun run test:unit",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Watch transitional application",
      "type": "shell",
      "command": "bun run start:dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
