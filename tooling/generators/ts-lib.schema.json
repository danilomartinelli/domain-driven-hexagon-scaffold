{
  "$schema": "https://json-schema.org/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "$default": { "$source": "argv", "index": 0 },
      "description": "Unique project name under src/packages."
    },
    "layer": { "type": "string", "enum": ["core"], "default": "core" }
  },
  "required": ["name"],
  "additionalProperties": false
}
