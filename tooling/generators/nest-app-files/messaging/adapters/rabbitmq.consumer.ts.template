import type { LoggerPort } from '@starter/core/logger';
import {
  RabbitConsumer,
  type ConsumerContext,
  type ConsumerOutcome,
  type Delivery,
} from '@starter/rabbitmq/consumer';
import { z } from 'zod';
import type { MessageHandler } from '../application/message-handler';

const envelope = z.object({ pattern: z.string().min(1), data: z.unknown() });
const identity = z.object({
  messageId: z.string().min(1),
  correlationId: z.string().min(1),
});

/** The shared consumer owns sessions, confirmations, retention and drain. */
export class RabbitMessageConsumer extends RabbitConsumer {
  constructor(
    config: { broker: string; queue: string },
    handlers: readonly MessageHandler[],
    logger: LoggerPort,
  ) {
    super({
      connection: config.broker,
      queue: config.queue,
      failureQueue: `${config.queue}.failed`,
      prefetch: 4,
      deliveryDeadlineMs: 10_000,
      service: '__name__',
      logger,
      handler: (delivery, context) =>
        dispatch(delivery, context, handlers, logger),
    });
  }
}

async function dispatch(
  message: Delivery,
  context: ConsumerContext,
  handlers: readonly MessageHandler[],
  logger: LoggerPort,
): Promise<ConsumerOutcome> {
  context.identify({
    eventId:
      typeof message.properties.messageId === 'string'
        ? message.properties.messageId
        : undefined,
  });
  let body: unknown;
  try {
    body = JSON.parse(message.content.toString()) as unknown;
  } catch {
    return { status: 'retained', reason: 'invalid-json' };
  }
  const parsed = envelope.safeParse(body);
  if (!parsed.success) {
    return { status: 'retained', reason: 'invalid-envelope' };
  }
  const metadata = identity.safeParse(message.properties);
  if (!metadata.success) {
    return { status: 'retained', reason: 'missing-identity' };
  }
  const handler = handlers.find(
    (entry) => entry.pattern === parsed.data.pattern,
  );
  if (!handler) {
    return { status: 'retained', reason: 'unknown-pattern' };
  }
  const { messageId: eventId, correlationId } = metadata.data;
  context.identify({ eventId, correlationId });
  const rejection = await handler.handle(parsed.data.data, {
    eventId,
    correlationId,
  });
  if (rejection?.accepted === false) {
    return { status: 'retained', reason: rejection.reason };
  }
  logger.log('Message handler completed.', {
    service: '__name__',
    operation: 'consumer.completed',
    eventId,
    correlationId,
  });
  return { status: 'completed' };
}
