//#if messaging
import { Logger } from '@nestjs/common';
//#endif
import {
  composeApplicationModule,
  type ApplicationFactories,
//#if messaging
  MESSAGE_HANDLERS,
//#endif
} from '@starter/nest-support/composition';
//#if persistence
import type { DatabasePool } from 'slonik';
import { DATABASE_POOL } from '../configs/tokens';
//#endif
//#if messaging
import type { MessageHandler } from '../application/message-handler';
import { messagingOptions } from '../configs/environment';
//#endif

const directory = new URL('../', import.meta.url);

// Register requirements in composition.json and bind the same group name here.
// Factories compose adapters; domain/ and application/ remain framework-free.
const functionality: ApplicationFactories['groups'] = {};
export const AppModule = await composeApplicationModule(directory, {
  integrations: {
//#if persistence
    persistence: async () => {
      const { DatabaseModule } = await import('../database/database.module');
      return {
        imports: [DatabaseModule],
        database: {
          inject: [DATABASE_POOL],
          useFactory: (pool: DatabasePool) => async () => {
            const { sql } = await import('slonik');
            await pool.query(sql.unsafe`SELECT 1`);
          },
        },
      };
    },
//#endif
//#if messaging
    messaging: async () => {
      const { RabbitMessageConsumer } = await import('../adapters/rabbitmq.consumer');
      return {
        providers: [{
          provide: RabbitMessageConsumer,
          inject: [MESSAGE_HANDLERS],
          useFactory: (handlers: MessageHandler[]) => new RabbitMessageConsumer(messagingOptions(), handlers, new Logger('Messaging')),
        }],
        consumer: RabbitMessageConsumer,
      };
    },
//#endif
//#if exposure
    exposure: async () => {
      const { GraphQLModule } = await import('@nestjs/graphql');
      const { ApolloDriver } = await import('@nestjs/apollo');
      const { StatusResolver } = await import('../adapters/status.resolver');
      return {
        imports: [GraphQLModule.forRoot({ driver: ApolloDriver, autoSchemaFile: true, playground: false })],
        providers: [StatusResolver],
      };
    },
//#endif
  },
  groups: functionality,
});
