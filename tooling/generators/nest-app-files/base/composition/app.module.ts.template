import {
//#if messaging
  Inject,
  Logger,
  Optional,
  type BeforeApplicationShutdown,
  type InjectionToken,
  type OnApplicationBootstrap,
//#endif
  Module,
  type ModuleMetadata,
} from '@nestjs/common';
//#if exposure
import { GraphQLModule } from '@nestjs/graphql';
import { ApolloDriver, type ApolloDriverConfig } from '@nestjs/apollo';
//#endif
//#if persistence
import { sql, type DatabasePool } from 'slonik';
import { DATABASE_POOL, DatabaseModule } from '../database/database.module';
//#endif
import { composeApplication, preflightApplication, readApplicationComposition } from '@starter/capabilities/composition';
import { HealthController, ServiceHealth } from '@starter/nest-support/operations';
//#if messaging
import type { MessageHandler } from '../application/message-handler';
import { RabbitTransport } from '../adapters/rabbitmq.transport';
import { messagingOptions } from '../configs/environment';
//#endif
//#if exposure
import { StatusResolver } from '../adapters/status.resolver';
//#endif

const directory = new URL('../', import.meta.url);
const declaration = preflightApplication(directory);

//#if messaging
type Functionality = ModuleMetadata & { handlers?: InjectionToken<MessageHandler>[] };
//#else
type Functionality = ModuleMetadata;
//#endif
// Register requirements in composition.json and bind the same group name here.
// Factories compose adapters; domain/ and application/ remain framework-free.
const functionality: Record<string, () => Functionality> = {};
const parts = composeApplication<Functionality>(declaration, readApplicationComposition(directory), {
  integrations: {
//#if persistence
    persistence: () => ({ imports: [DatabaseModule] }),
//#endif
//#if messaging
    messaging: () => ({}),
//#endif
//#if exposure
    exposure: () => ({
      imports: [GraphQLModule.forRoot<ApolloDriverConfig>({ driver: ApolloDriver, autoSchemaFile: true, playground: false })],
      providers: [StatusResolver],
    }),
//#endif
  },
  groups: functionality,
});
//#if messaging
const handlers = parts.flatMap((part) => part.handlers ?? []);
//#endif

@Module({
  imports: parts.flatMap((part) => part.imports ?? []),
  controllers: [
    HealthController,
    ...parts.flatMap((part) => part.controllers ?? []),
  ],
  providers: [
    ...parts.flatMap((part) => part.providers ?? []),
//#if messaging
    ...(declaration.messaging ? [{
      provide: RabbitTransport,
      inject: handlers,
      useFactory: (...registered: MessageHandler[]) => new RabbitTransport(messagingOptions(), registered, new Logger('Messaging')),
    }] : []),
//#endif
    {
      provide: ServiceHealth,
      inject: [
//#if persistence
        { token: DATABASE_POOL, optional: true },
//#endif
//#if messaging
        { token: RabbitTransport, optional: true },
//#endif
      ],
      useFactory: (
//#if persistence
        pool?: DatabasePool,
//#endif
//#if messaging
        transport?: RabbitTransport,
//#endif
      ) => new ServiceHealth(declaration, {
//#if persistence
        ...(pool ? { database: async () => { await pool.query(sql.unsafe`SELECT 1`); } } : {}),
//#endif
//#if messaging
        ...(transport ? { consumer: () => transport.diagnostics.snapshot() } : {}),
//#endif
      }),
    },
  ],
})
//#if messaging
export class AppModule implements OnApplicationBootstrap, BeforeApplicationShutdown {
  constructor(@Optional() @Inject(RabbitTransport) private readonly transport?: RabbitTransport) {}
  onApplicationBootstrap(): void { this.transport?.start(); }
  async beforeApplicationShutdown(): Promise<void> { await this.transport?.stop(); }
}
//#else
// eslint-disable-next-line @typescript-eslint/no-extraneous-class -- Nest requires a decorated module class.
export class AppModule {}
//#endif
