{
  "name": "generators",
  "projectType": "library",
  "tags": ["scope:tooling", "type:tooling"],
  "implicitDependencies": ["test-runner"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun --bun eslint tooling/generators --max-warnings 0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun --bun tsc --project tooling/generators/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun test ./scripts/tests/library-generators.test.ts ./scripts/tests/app-generator.test.ts"
      }
    },
    "test-component": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --no-env-file test ./scripts/tests/app-generator-live.test.ts"
      }
    }
  }
}
