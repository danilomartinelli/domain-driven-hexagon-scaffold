{
  "name": "config",
  "projectType": "library",
  "tags": ["scope:tooling"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "bun --bun eslint tooling/config eslint.config.mjs prettier.config.mjs .dependency-cruiser.mjs --max-warnings 0",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "bun --bun tsc --project tooling/config/tsconfig.json",
        "cwd": "."
      }
    },
    "lint-fix": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun --bun eslint tooling/config eslint.config.mjs prettier.config.mjs .dependency-cruiser.mjs --max-warnings 0 --fix",
        "cwd": "."
      }
    }
  }
}
