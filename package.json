{
  "name": "domain-driven-hexagon",
  "version": "2.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "NODE_ENV=production bun src/main.ts",
    "lint": "eslint \"{src,apps,libs,tests}/**/*.ts\" --fix",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "test:debug": "bun --inspect-brk test",
    "test:e2e": "bun test",
    "docker:env": "docker compose --project-name ddh --file docker/docker-compose.yml up -d --wait postgres",
    "depcruise": "depcruise",
    "deps:validate": "depcruise src --config .dependency-cruiser.js --output-type err-long",
    "deps:graph": "depcruise src --include-only \"^src\" --config --output-type dot | dot -T svg > assets/dependency-graph.svg",
    "docker:tests": "docker compose --project-name ddh --file docker/docker-compose.yml up -d --wait postgres-test",
    "migration:create": "bun database/migrate.mjs create",
    "migration:up": "bun database/migrate.mjs up",
    "migration:up:tests": "NODE_ENV=test bun database/migrate.mjs up",
    "migration:down": "bun database/migrate.mjs down",
    "migration:down:tests": "NODE_ENV=test bun database/migrate.mjs down",
    "migration:status": "bun database/migrate.mjs status",
    "migration:status:tests": "NODE_ENV=test bun database/migrate.mjs status",
    "seed:up": "bun database/seed.mjs",
    "seed:up:tests": "NODE_ENV=test bun database/seed.mjs",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/apollo": "^10.1.3",
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/cqrs": "^9.0.1",
    "@nestjs/event-emitter": "^1.3.1",
    "@nestjs/graphql": "^10.1.2",
    "@nestjs/microservices": "^9.1.2",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/swagger": "^6.1.2",
    "apollo-server-core": "^3.10.2",
    "apollo-server-express": "^3.10.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "dotenv": "^16.0.2",
    "env-var": "^7.3.0",
    "graphql": "^16.6.0",
    "nanoid": "^3.3.4",
    "nestjs-console": "^8.0.0",
    "nestjs-request-context": "^2.1.0",
    "oxide.ts": "^1.0.5",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "slonik": "49.10.10",
    "uuid": "^9.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^9.0.0",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "@types/supertest": "^2.0.11",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "dependency-cruiser": "^12.10.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "prettier": "^2.3.2",
    "supertest": "^6.1.3",
    "typescript": "6.0.3",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "@types/bun": "1.4.2",
    "jest-cucumber": "4.5.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  }
}
