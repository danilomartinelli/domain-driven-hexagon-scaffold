{
  "name": "domain-driven-hexagon",
  "version": "2.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "nx": "NX_LOAD_DOT_ENV_FILES=false NX_DAEMON=false bun ./node_modules/.bin/nx",
    "format": "bun run nx run workspace:format",
    "format:check": "bun run nx run workspace:format-check",
    "start": "bun run nx run-many --projects=user,wallet --target=serve --parallel=2",
    "start:dev": "bun run nx run-many --projects=user,wallet --target=watch --parallel=2",
    "start:debug": "bun run nx run-many --projects=user,wallet --target=debug --parallel=2",
    "start:prod": "NODE_ENV=production bun run start",
    "start:wallet": "bun run nx run wallet:serve",
    "start:wallet:dev": "bun run nx run wallet:watch",
    "start:wallet:debug": "bun run nx run wallet:debug",
    "lint": "bun run nx run-many --target=lint",
    "lint:fix": "bun run nx run-many --target=lint-fix",
    "typecheck": "bun run nx run-many --target=typecheck",
    "test": "bun run test:unit",
    "test:unit": "bun run nx run-many --target=test",
    "test:watch": "bun run nx run-many --target=test-watch",
    "test:cov": "bun run nx run-many --target=test-coverage",
    "test:debug": "bun run nx run user:test-debug",
    "test:e2e": "bun run nx run e2e:e2e",
    "test:e2e:prepared": "bun run nx run e2e:e2e-prepared",
    "test:component": "bun run nx run-many --target=test-component",
    "test:tooling": "bun run nx run test-runner:test-live",
    "docker:env": "bun run nx run infrastructure:up",
    "docker:tests": "bun run nx run infrastructure:up-test",
    "depcruise": "bun ./node_modules/.bin/depcruise",
    "deps:validate": "bun run lint:boundaries",
    "deps:graph": "bun --no-env-file scripts/dependency-graph.ts",
    "lint:boundaries": "bun run nx run workspace:boundaries",
    "prepare": "husky",
    "check:code": "bun run check:workspace && bun run lint && bun run typecheck && bun run lint:boundaries && bun run test:unit",
    "check": "bun run check:code && bun run check:docs && bun run format:check",
    "check:full": "bun run check && bun run audit:changed && bun run test:tooling && bun run test:e2e && bun run test:component",
    "migration:create": "bun run nx run database:migration-create",
    "migration:up": "bun run nx run database:migration-up",
    "migration:up:tests": "bun run nx run database:migration-up --configuration=test",
    "migration:down": "bun run nx run database:migration-down",
    "migration:down:tests": "bun run nx run database:migration-down --configuration=test",
    "migration:status": "bun run nx run database:migration-status",
    "migration:status:tests": "bun run nx run database:migration-status --configuration=test",
    "seed:up": "bun run nx run database:seed",
    "seed:up:tests": "bun run nx run database:seed --configuration=test",
    "check:workspace": "bun test ./scripts/tests/command.test.ts ./scripts/tests/workspace.test.ts ./scripts/tests/boundaries.test.ts ./scripts/tests/characterize.test.ts ./scripts/tests/test-counts.test.ts ./scripts/tests/dependency-audit.test.ts ./scripts/tests/environment-guard.test.ts ./scripts/tests/database-target.test.ts ./scripts/tests/cleanup.test.ts ./scripts/tests/fixture-lint.test.ts ./scripts/tests/regression-suite.test.ts ./scripts/tests/owned-container.test.ts ./scripts/tests/docs.test.ts ./scripts/tests/search.test.ts ./scripts/tests/agent-automation.test.ts ./scripts/tests/dependency-graph.test.ts ./scripts/tests/explore.test.ts",
    "audit:changed": "bun scripts/audit-changed.ts",
    "characterize": "bun scripts/characterize.ts",
    "env:prepare": "bun --no-env-file scripts/environment-cli.ts prepare",
    "env:exec": "bun --no-env-file scripts/environment-cli.ts exec",
    "env:down": "bun --no-env-file scripts/environment-cli.ts down",
    "check:docs": "bun scripts/check-docs.ts",
    "search": "bun scripts/search.ts",
    "explore": "bun --no-env-file scripts/explore.ts",
    "typescript:query": "bun --no-env-file scripts/typescript-query.ts",
    "agents:opencode": "OPENCODE_DISABLE_PROJECT_CONFIG=false opencode",
    "start:user": "bun run nx run user:serve",
    "start:user:dev": "bun run nx run user:watch",
    "start:user:debug": "bun run nx run user:debug",
    "test:user:component": "bun run nx run user:test-component"
  },
  "dependencies": {
    "@nestjs/apollo": "14.0.3",
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/cqrs": "12.1.0",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/microservices": "12.1.1",
    "@nestjs/platform-express": "12.1.1",
    "@nestjs/swagger": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.4",
    "env-var": "7.5.0",
    "graphql": "16.14.2",
    "nanoid": "6.0.1",
    "oxide.ts": "1.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "slonik": "49.10.10",
    "zod": "4.6.5",
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "commander": "15.0.0",
    "cors": "2.8.6",
    "@starter/core": "workspace:*",
    "@starter/nest-support": "workspace:*",
    "@starter/integration-contracts": "workspace:*",
    "amqplib": "2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.1.1",
    "@starter/config": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.4.0",
    "entities": "8.1.0",
    "eslint": "10.11.0",
    "github-slugger": "2.0.0",
    "husky": "9.1.7",
    "jest-cucumber": "4.5.0",
    "lint-staged": "17.6.0",
    "node-pg-migrate": "9.0.0",
    "nx": "23.2.1",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "axios": "1.20.0",
    "brace-expansion": "5.0.12",
    "glob": "13.0.6",
    "reflect-metadata": "0.2.2",
    "uuid": "14.0.2",
    "smol-toml": "1.9.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "workspaces": [
    "src/packages/*",
    "tooling/config"
  ],
  "nx": {
    "includedScripts": []
  }
}
